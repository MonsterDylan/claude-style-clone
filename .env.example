# Copy to ~/.config/style-clone/.env  (both lines are optional)

# Needed to list an Instagram or TikTok creator's videos from the handle alone.
# Free: sign up at apify.com (no card, $5 of usage a month, a run here uses about 10 cents),
# then Settings > API & Integrations > copy the Personal API token.
# Without it: paste 10 links, or use a YouTube handle, which needs no key.
APIFY_TOKEN=

# Only needed for words-per-minute. Free tier works. console.groq.com/keys
# Without it everything else still runs.
GROQ_API_KEY=
